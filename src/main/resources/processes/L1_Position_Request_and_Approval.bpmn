<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1phfgf2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="jprdemo_jobPositionRequestApprovalProcess_v1" name="JPRDEMO Job Position Request &#38; Approval" isExecutable="true">
    <bpmn:serviceTask id="sendEmail" name="Email Position Requester (Rejected)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jprdemo_com.kyndryl.camunda:sendEmail:1" />
        <zeebe:taskHeaders>
          <zeebe:header key="emailType" value="POSITION_REJECTED" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i7fhhf</bpmn:incoming>
      <bpmn:outgoing>Flow_1f6cltt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0h38ux7" name="Position Approved?">
      <bpmn:incoming>Flow_0oitf99</bpmn:incoming>
      <bpmn:outgoing>Flow_1i7fhhf</bpmn:outgoing>
      <bpmn:outgoing>Flow_0yoxixr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="savePositionToDatabase" name="Save Job Position to Database">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jprdemo_com.kyndryl.camunda:saveJobPosition:1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0yoxixr</bpmn:incoming>
      <bpmn:incoming>Flow_0ft1j9u</bpmn:incoming>
      <bpmn:outgoing>Flow_1a2tmdv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="jobPositionApproval" name="Job Position Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="jobPositionApprovalForm_v1" />
        <zeebe:ioMapping>
          <zeebe:output source="=approved = &#34;true&#34;" target="approved" />
          <zeebe:output source="=approvalComment" target="approvalComment" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03tn67p</bpmn:incoming>
      <bpmn:outgoing>Flow_0oitf99</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="jobPositionSpecification" name="Job Position Specification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="jobPositionSpecification_v1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0u58p0x</bpmn:incoming>
      <bpmn:incoming>Flow_0sval23</bpmn:incoming>
      <bpmn:outgoing>Flow_18u1pq9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="jobPositionValidation" name="Job Position Validation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="jobPositionValidation_v1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18u1pq9</bpmn:incoming>
      <bpmn:outgoing>Flow_0j3atv5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_10bjw16" name="Further Approval Required?">
      <bpmn:incoming>Flow_1b9r0gj</bpmn:incoming>
      <bpmn:outgoing>Flow_0ft1j9u</bpmn:outgoing>
      <bpmn:outgoing>Flow_03tn67p</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="Event_1wzijdo" name="Open Job Position">
      <bpmn:outgoing>Flow_0u58p0x</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1m7q763" name="HR check result?">
      <bpmn:incoming>Flow_0j3atv5</bpmn:incoming>
      <bpmn:outgoing>Flow_0sval23</bpmn:outgoing>
      <bpmn:outgoing>Flow_1b9r0gj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1f6cltt" sourceRef="sendEmail" targetRef="Event_1qyrhqs" />
    <bpmn:sequenceFlow id="Flow_1i7fhhf" name="No" sourceRef="Gateway_0h38ux7" targetRef="sendEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(approved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0oitf99" sourceRef="jobPositionApproval" targetRef="Gateway_0h38ux7" />
    <bpmn:sequenceFlow id="Flow_0yoxixr" name="Yes" sourceRef="Gateway_0h38ux7" targetRef="savePositionToDatabase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ft1j9u" name="No" sourceRef="Gateway_10bjw16" targetRef="savePositionToDatabase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerialPosition = false and expectedSalary &lt;= 6700</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03tn67p" name="Yes" sourceRef="Gateway_10bjw16" targetRef="jobPositionApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=managerialPosition = true or expectedSalary &gt; 6700</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0u58p0x" sourceRef="Event_1wzijdo" targetRef="jobPositionSpecification" />
    <bpmn:sequenceFlow id="Flow_0sval23" name="NOK" sourceRef="Gateway_1m7q763" targetRef="jobPositionSpecification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hrCheckResult = "NOK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18u1pq9" sourceRef="jobPositionSpecification" targetRef="jobPositionValidation" />
    <bpmn:sequenceFlow id="Flow_0j3atv5" sourceRef="jobPositionValidation" targetRef="Gateway_1m7q763" />
    <bpmn:sequenceFlow id="Flow_1b9r0gj" name="OK" sourceRef="Gateway_1m7q763" targetRef="Gateway_10bjw16">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hrCheckResult = "OK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1qyrhqs" name="Job Position Rejected">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1f6cltt</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1k42j1h" errorRef="Error_0h0j21e" />
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_1xvdd0z" name="Publish in the Hiring Portal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="jprdemo_com.kyndryl.camunda_publishToHiringPortals:1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1a2tmdv</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_13oa8wh" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1a2tmdv" sourceRef="savePositionToDatabase" targetRef="Event_1xvdd0z" />
    <bpmn:textAnnotation id="TextAnnotation_1xcycaa">
      <bpmn:text>Why do we need this step here?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0mie6j0" associationDirection="None" sourceRef="savePositionToDatabase" targetRef="TextAnnotation_1xcycaa" />
  </bpmn:process>
  <bpmn:error id="Error_0h0j21e" name="Job Position Rejected" errorCode="jobPositionRejected" />
